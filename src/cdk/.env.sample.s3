# S3 source: deploy from a zip in your own bucket (no GitHub fork or connection).
# CONFIG_FILE_URL is optional and only pulls a remote preset at deploy time.
CONFIG_BUCKET=your-config-bucket-name
ORGANIZATION_NAME=aws-samples
REPOSITORY_NAME=one-observability-demo
BRANCH_NAME=your-branch-name
WORKING_FOLDER=src/cdk
STACK_NAME=TestStack
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Lets your day-to-day IAM role run kubectl against the petsite-net EKS cluster.
EKS_CLUSTER_ACCESS_ROLE_NAME=RoleName

ENABLE_WAGGLE_AI_AGENTS=true
# OpenSearch needs OpenSearch Serverless quota; off by default for a clean deploy.
ENABLE_OPENSEARCH=false
